<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer glow effect -->
    <item>
        <shape android:shape="oval">
            <size
                android:width="100dp"
                android:height="100dp" />
            <solid android:color="@color/fab_glow" />
            <alpha android:value="30" />
        </shape>
    </item>

    <!-- Main button background -->
    <item>
        <shape android:shape="oval">
            <size
                android:width="72dp"
                android:height="72dp" />
            <solid android:color="@color/fab_background" />
            <stroke
                android:width="2dp"
                android:color="@color/primary_light" />
        </shape>
    </item>

    <!-- Inner gradient overlay -->
    <item>
        <shape android:shape="oval">
            <size
                android:width="68dp"
                android:height="68dp" />
            <gradient
                android:startColor="@color/accent_start"
                android:endColor="@color/accent_end"
                android:angle="270" />
            <alpha android:value="25" />
        </shape>
    </item>
</layer-list>
