<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer ring -->
    <item>
        <shape android:shape="oval">
            <size
                android:width="48dp"
                android:height="48dp" />
            <stroke
                android:width="3dp"
                android:color="@color/listening_inactive" />
        </shape>
    </item>

    <!-- Inner fill -->
    <item>
        <shape android:shape="oval">
            <size
                android:width="40dp"
                android:height="40dp" />
            <solid android:color="@color/surface_variant" />
        </shape>
    </item>

    <!-- Mic icon center -->
    <item>
        <shape android:shape="oval">
            <size
                android:width="20dp"
                android:height="20dp" />
            <solid android:color="@color/primary" />
        </shape>
    </item>
</layer-list>
